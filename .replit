# БЛОК 1: НАСТРОЙКИ ЗАПУСКА (RUN)
# Команда для запуска сервера Django
# python — интерпретатор
# manage.py — скрипт управления Django
# runserver — команда запуска сервера разработки
# 0.0.0.0:3000 — хост (доступен с любого IP) и порт
run = ["python", "manage.py", "runserver", "0.0.0.0:3000"]

# БЛОК 2: ТОЧКА ВХОДА (ENTRYPOINT)
# Главный файл, с которого начинается выполнение проекта
entrypoint = "manage.py"

# БЛОК 3: МОДУЛИ PYTHON
# Указывает версию интерпретатора Python для Replit
# python-3.10:v18-20230807-322e88b — конкретная сборка Python 3.10
modules = ["python-3.10:v18-20230807-322e88b"]

# БЛОК 4: СКРЫТЫЕ ПАПКИ
# Папки, которые не отображаются в файловом менеджере Replit
# .pythonlibs — директория с установленными библиотеками Python
hidden = [".pythonlibs"]

# БЛОК 5: СИСТЕМНЫЕ ЗАВИСИМОСТИ (NIX)
[nix]
# Канал поставки пакетов Nix (стабильная версия от мая 2024 года)
channel = "stable-24_05"

# БЛОК 6: НАСТРОЙКИ ТЕСТИРОВАНИЯ (UNIT TEST)
[unitTest]
# Язык, на котором написаны тесты
language = "python3"

# БЛОК 7: РАЗВЁРТЫВАНИЕ (DEPLOYMENT)
[deployment]
# Команда запуска при развёртывании проекта
run = ["python", "manage.py", "runserver", "0.0.0.0:3000"]
# Целевая платформа развёртывания — Google Compute Engine
deploymentTarget = "gce"

# БЛОК 8: НАСТРОЙКИ ПОРТОВ (PORTS)
[[ports]]
# Внутренний порт контейнера (на котором работает Django)
localPort = 3000
# Внешний порт, открытый для доступа через интернет
externalPort = 80

# БЛОК 9: РЕЖИМ АГЕНТА (ЭКСПЕРТНЫЙ РЕЖИМ)
[agent]
# Включает расширенные возможности для AI-агента в Replit
expertMode = true
